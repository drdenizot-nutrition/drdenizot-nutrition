# Normalize line endings
* text=auto

# PHP
*.php text diff=php

# CSS
*.css text diff

# JavaScript
*.js text diff

# JSON
*.json text diff

# Markdown
*.md text diff

# YAML
*.yml text
*.yaml text

# Shell scripts
*.sh text eol=lf

# SVG
*.svg text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary